<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <!--[if !mso]><!-->
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <!--<![endif]-->
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="format-detection" content="telephone=no, date=no, address=no, email=no">
  <meta name="x-apple-disable-message-reformatting">
  <!-- Light only: clients that auto-invert would turn the cream and brown to mud. -->
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
  <title>{{businessName}} — Appointment confirmed</title>
  <style type="text/css">
    #outlook a { padding: 0; }
    .ExternalClass, .ExternalClass p, .ExternalClass td, .ExternalClass div, .ExternalClass span { line-height: 100%; }
    table, td { mso-table-lspace: 0; mso-table-rspace: 0; border-collapse: collapse; }
    body, td, p, a, span { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; mso-line-height-rule: exactly; }
    a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; }
    body { margin: 0; padding: 0; width: 100% !important; -webkit-font-smoothing: antialiased; }
    @media screen and (max-width: 620px) {
      .card { padding: 32px 22px !important; }
      .headline { font-size: 26px !important; }
      .details td { display: block !important; width: 100% !important; text-align: left !important; padding-bottom: 12px !important; }
      .button { display: block !important; margin: 0 0 10px !important; }
    }
  </style>
  <!--[if mso]>
  <style type="text/css">body, table, td, a, p { font-family: Arial, Helvetica, sans-serif !important; }</style>
  <![endif]-->
</head>
<body style="margin: 0; padding: 0; background-color: #FAF6F1;">
  <!-- Preview line shown next to the subject in the inbox. -->
  <div style="display: none; max-height: 0; overflow: hidden; mso-hide: all; font-size: 1px; line-height: 1px; color: #FAF6F1;">{{previewText}}</div>

  <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#FAF6F1" style="background-color: #FAF6F1;">
    <tr>
      <td align="center" style="padding: 36px 12px;">
        <!--[if mso]><table role="presentation" width="600" align="center" border="0" cellspacing="0" cellpadding="0"><tr><td><![endif]-->
        <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="max-width: 600px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; color: #241D18;">

          <!-- 1. Wordmark — the site's header treatment, in text so it shows with images off -->
          <tr>
            <td align="center" style="padding: 4px 0 28px;">
              <div style="font-size: 16px; font-weight: 800; letter-spacing: 0.42em; text-transform: uppercase; color: #241D18; padding-left: 0.42em;">{{wordmarkPrimary}}&nbsp;{{wordmarkSecondary}}</div>
              <div style="font-size: 10px; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: #6F635A; padding-left: 0.3em; margin-top: 6px;">{{locationLine}}</div>
            </td>
          </tr>

          <!-- 2. The confirmation -->
          <tr>
            <td class="card" bgcolor="#FFFFFF" style="background-color: #FFFFFF; border-radius: 20px; padding: 44px 40px;">
              <div style="font-size: 11px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: #5C4634;">Appointment confirmed</div>
              <h1 class="headline" style="margin: 10px 0 0; font-size: 30px; line-height: 1.15; font-weight: 800; letter-spacing: -0.02em; color: #241D18;">You're booked, {{customerFirstName}}.</h1>
              <p style="margin: 12px 0 0; font-size: 15px; line-height: 1.6; color: #6F635A;">We can't wait to see you. Here's everything in one place.</p>

              <!-- 2a. When and with whom -->
              <table role="presentation" class="details" width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#F0E7DD" style="background-color: #F0E7DD; border-radius: 14px; margin-top: 28px;">
                <tr>
                  <td width="50%" valign="top" style="padding: 20px 22px 8px;">
                    <div style="font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #5C4634;">Date</div>
                    <div style="margin-top: 4px; font-size: 15px; font-weight: 700;">{{appointmentDateLabel}}</div>
                  </td>
                  <td width="50%" valign="top" style="padding: 20px 22px 8px;">
                    <div style="font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #5C4634;">Time</div>
                    <div style="margin-top: 4px; font-size: 15px; font-weight: 700;">{{appointmentTimeLabel}}</div>
                  </td>
                </tr>
                <tr>
                  <td width="50%" valign="top" style="padding: 8px 22px 20px;">
                    <div style="font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #5C4634;">With</div>
                    <div style="margin-top: 4px; font-size: 15px; font-weight: 700;">{{professionalName}}</div>
                  </td>
                  <td width="50%" valign="top" style="padding: 8px 22px 20px;">
                    <div style="font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #5C4634;">Length</div>
                    <div style="margin-top: 4px; font-size: 15px; font-weight: 700;">{{totalDurationLabel}}</div>
                  </td>
                </tr>
              </table>

              <!-- 2b. What's booked, and what's paid -->
              <div style="margin-top: 32px; font-size: 11px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: #6F635A;">Your services</div>
              <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="margin-top: 8px;">
                {{#each services}}
                <tr>
                  <td valign="top" style="padding: 14px 0; border-bottom: 1px solid #EBE3DA;">
                    <div style="font-size: 15px; font-weight: 600;">{{this.name}}</div>
                    <div style="margin-top: 2px; font-size: 13px; color: #6F635A;">{{this.durationLabel}}{{#if this.description}} · {{this.description}}{{/if}}</div>
                  </td>
                  <td align="right" valign="top" style="padding: 14px 0 14px 16px; border-bottom: 1px solid #EBE3DA; font-size: 15px; font-weight: 600; white-space: nowrap;">{{this.priceLabel}}</td>
                </tr>
                {{/each}}
                <tr>
                  <td style="padding: 16px 0 0; font-size: 15px; font-weight: 800;">Total</td>
                  <td align="right" style="padding: 16px 0 0; font-size: 15px; font-weight: 800;">{{totalPriceLabel}}</td>
                </tr>
                {{#if retainer}}
                <tr>
                  <td style="padding: 8px 0 0; font-size: 14px; color: #6F635A;">Retainer paid · {{retainer.cardLabel}}</td>
                  <td align="right" style="padding: 8px 0 0; font-size: 14px; color: #6F635A; white-space: nowrap;">&minus;{{retainer.amountLabel}}</td>
                </tr>
                <tr>
                  <td style="padding: 14px 0 0; font-size: 16px; font-weight: 800; color: #5C4634;">Due at your appointment</td>
                  <td align="right" style="padding: 14px 0 0; font-size: 16px; font-weight: 800; color: #5C4634;">{{retainer.balanceLabel}}</td>
                </tr>
                {{/if}}
              </table>
              {{#if retainer}}
              <p style="margin: 14px 0 0; font-size: 12px; line-height: 1.6; color: #6F635A;">The retainer holds your time and counts toward your total.{{#unless retainer.refundable}} It's non-refundable.{{/unless}}</p>
              {{/if}}

              <!-- 2c. Getting there, getting in touch -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin-top: 32px;">
                <tr>
                  <td>
                    <a class="button" href="{{directionsUrl}}" style="display: inline-block; padding: 14px 26px; margin-right: 8px; border-radius: 999px; background-color: #5C4634; color: #FFFFFF; font-size: 14px; font-weight: 700; text-decoration: none;">Get directions</a><a class="button" href="{{businessSmsHref}}" style="display: inline-block; padding: 13px 25px; border-radius: 999px; border: 1px solid #D9C2AC; color: #241D18; font-size: 14px; font-weight: 700; text-decoration: none;">Text the studio</a>
                  </td>
                </tr>
              </table>
              <p style="margin: 24px 0 0; font-size: 13px; line-height: 1.6; color: #6F635A;">Need to change something? Call or text us at <a href="{{businessPhoneHref}}" style="color: #5C4634; font-weight: 600; text-decoration: none;">{{businessPhone}}</a> — we're happy to help.</p>
            </td>
          </tr>

          <!-- 3. Footer -->
          <tr>
            <td align="center" style="padding: 28px 16px 8px; font-size: 12px; line-height: 1.7; color: #6F635A;">
              <div style="font-weight: 700; color: #241D18;">{{businessName}}</div>
              <div><a href="{{directionsUrl}}" style="color: #6F635A; text-decoration: none;">{{businessAddress}}</a></div>
              <div style="margin-top: 10px;">
                <a href="{{websiteUrl}}" style="color: #5C4634; font-weight: 600; text-decoration: none;">Website</a>
                &nbsp;·&nbsp;
                <a href="{{instagramUrl}}" style="color: #5C4634; font-weight: 600; text-decoration: none;">Instagram</a>
                &nbsp;·&nbsp;
                <a href="{{tiktokUrl}}" style="color: #5C4634; font-weight: 600; text-decoration: none;">TikTok</a>
                &nbsp;·&nbsp;
                <a href="{{facebookUrl}}" style="color: #5C4634; font-weight: 600; text-decoration: none;">Facebook</a>
              </div>
              <div style="margin-top: 14px; font-size: 11px; color: #9A8E84;">You're getting this because you booked an appointment at {{businessName}}.</div>
            </td>
          </tr>
        </table>
        <!--[if mso]></td></tr></table><![endif]-->
      </td>
    </tr>
  </table>
</body>
</html>
