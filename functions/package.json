{
  "name": "functions",
  "description": "Cloud Functions for KTLN Studio: booking with a card-on-file retainer (Stripe) and the confirmation email",
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^7.2.5",
    "handlebars": "^4.7.9",
    "nodemailer": "^9.0.3",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "eslint": "^5.12.0",
    "eslint-plugin-promise": "^4.0.1",
    "firebase-functions-test": "^3.5.0"
  },
  "private": true,
  "overrides": {
    "uuid": "^11.1.1",
    "flatted": "^3.4.2",
    "ts-deepmerge": "^8.0.0",
    "tmp": "^0.2.7"
  }
}
