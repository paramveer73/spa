# Copy this file to .env and fill in real values. .env is gitignored so the
# app password never ends up in source control — .env.example stays tracked
# as documentation of what's required.
#
# How to get a Gmail App Password (lasts indefinitely, unlike the old OAuth2
# refresh token which silently expired after a few quiet weeks):
#   1. Turn on 2-Step Verification on the Gmail account that sends these
#      emails: https://myaccount.google.com/security
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail" — Google gives you a 16-character
#      code (shown as 4 groups of 4, e.g. "abcd efgh ijkl mnop").
#   4. Paste it below as GMAIL_APP_PASSWORD. Spaces are fine either way —
#      they're stripped before use.

# The Gmail address these confirmation emails are sent from — the studio's
# own account. Required: without it no email is sent (bookings still go through).
GMAIL_USER=ktlnstudio@gmail.com

# The 16-character App Password generated above.
GMAIL_APP_PASSWORD=

# Optional: where an internal copy of every confirmation goes (sent as a
# second "to" recipient). Defaults to GMAIL_USER if left blank.
NOTIFY_EMAIL=

# --- Instagram feed (GET /instagramFeed) ------------------------------------
# Powers the homepage Instagram grid, replacing the old POWr widget. Requires
# the IG account to be a Business or Creator account linked to a Facebook
# Page, and a Facebook Developer App with the Instagram Graph API product
# added — both one-time manual setup steps in Meta's own tools, not
# something this app can do for you.
#
# How to get IG_USER_ID / IG_ACCESS_TOKEN:
#   1. developers.facebook.com -> create an app -> add "Instagram Graph API"
#   2. Use the Graph API Explorer (or the OAuth flow) to get a User Access
#      Token with the instagram_basic permission, for the Page linked to the
#      IG account.
#   3. Exchange it for a long-lived token (60 days):
#      GET https://graph.facebook.com/oauth/access_token
#        ?grant_type=fb_exchange_token
#        &client_id={app-id}&client_secret={app-secret}
#        &fb_exchange_token={short-lived-token}
#   4. GET https://graph.instagram.com/me?fields=id&access_token={token}
#      to get IG_USER_ID.
#   5. This token expires after 60 days — refresh via
#      GET https://graph.instagram.com/refresh_access_token
#        ?grant_type=ig_refresh_token&access_token={token}
#      any time after the token is at least 24h old, and re-paste it below.
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Stripe (cards on file + booking retainer) -------------------------------
# Dashboard → Developers → API keys → Secret key. Use sk_test_… while
# developing; production gets sk_live_… as a secret instead of this file:
#   firebase functions:secrets:set STRIPE_SECRET_KEY
STRIPE_SECRET_KEY=

# Dashboard → Developers → Webhooks → add an endpoint for
#   <function url>/stripe/webhook   (event: payment_intent.succeeded)
# and paste its signing secret (whsec_…). Locally, `stripe listen
# --forward-to <emulator url>/stripe/webhook` prints a temporary one.
# Production: firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
STRIPE_WEBHOOK_SECRET=
